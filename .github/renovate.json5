{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  extends: [
    "config:best-practices", // stricter defaults than config:recommended
    ":disableDependencyDashboard",
    ":semanticCommits", // chore(deps): ... commit messages
    ":timezone(America/Los_Angeles)",
  ],

  prConcurrentLimit: 5,
  prHourlyLimit: 2,
  rebaseWhen: "behind-base-branch",

  // Security advisories always get a PR, regardless of schedule
  vulnerabilityAlerts: {
    schedule: ["at any time"],
    labels: ["security"],
  },

  // gotk-components.yaml is generated by flux bootstrap — Renovate can't patch it correctly
  ignorePaths: ["kubernetes/flux-system/gotk-components.yaml"],

  // --- Managers ---
  // Flux manager auto-detects HelmRelease, HelmRepository, OCIRepository, Kustomization
  flux: {
    managerFilePatterns: ["/kubernetes/.+\\.ya?ml$/"],
  },
  // helm-values handles image: { repository, tag } blocks inside HelmRelease values:
  "helm-values": {
    managerFilePatterns: ["/kubernetes/.+\\.ya?ml$/"],
  },
  // kubernetes manager catches bare image: references in YAML
  kubernetes: {
    managerFilePatterns: ["/kubernetes/.+\\.ya?ml$/"],
  },

  // --- Custom Managers ---
  customManagers: [
    // Track Talos version in topf.yaml (written without "v" — topf adds it)
    {
      customType: "regex",
      managerFilePatterns: ["/talos/topf\\.yaml$/"],
      matchStrings: [
        "talosVersion:\\s*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?",
      ],
      datasourceTemplate: "github-releases",
      depNameTemplate: "siderolabs/talos",
      extractVersionTemplate: "^v(?<version>.+)$",
      versioningTemplate: "semver",
    },
    // Track Kubernetes version in topf.yaml against the kubelet images Talos runs
    {
      customType: "regex",
      managerFilePatterns: ["/talos/topf\\.yaml$/"],
      matchStrings: [
        "kubernetesVersion:\\s*[\"']?(?<currentValue>v\\d+\\.\\d+\\.\\d+[^\"'\\s]*)[\"']?",
      ],
      datasourceTemplate: "docker",
      depNameTemplate: "ghcr.io/siderolabs/kubelet",
      versioningTemplate: "semver",
    },
  ],

  // --- Package Rules ---
  packageRules: [
    {
      description: "Automerge patch updates",
      matchUpdateTypes: ["patch"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: "3 days", // guard against yanked releases
    },
    {
      // A digest bump on a mutable tag is an upstream rebuild, not a release:
      // every rebuild resets the age clock, so an age gate may never pass.
      description: "Automerge digest updates (no age gate)",
      matchUpdateTypes: ["digest"],
      automerge: true,
      automergeType: "branch",
      minimumReleaseAge: null,
    },
    {
      // Longhorn-backed, Recreate strategy: a merge restarts the database, so
      // check volume health first.
      description: "Databases: manual review for digest updates",
      matchPackageNames: ["/(^|/)postgres$/", "/(^|/)mariadb$/"],
      matchUpdateTypes: ["digest"],
      automerge: false,
    },
    {
      description: "MariaDB: upgrade safety notes",
      matchPackageNames: ["/(^|/)mariadb$/"],
      prBodyNotes: [
        "The `mariadb-upgrade-rehearsal` check upgrades a Flyway-seeded data dir from the base tag to this one on arm64. A pre-upgrade Helm hook dumps the live DB to the `grimmory-mariadb-backups` PVC before rollout, and `grimmory-mariadb-data` has daily Longhorn snapshots.",
      ],
    },
    {
      description: "Longhorn: manual review required",
      matchPackageNames: ["longhorn"],
      automerge: false,
      minimumReleaseAge: "7 days",
      addLabels: ["renovate/longhorn", "needs-review"],
    },
    {
      // Merging changes nothing on the cluster, so the cluster is upgraded
      // from the PR branch first and the PR merged after — main then always
      // matches what the nodes run.
      description: "Talos (cluster + talosctl client): upgrade cluster, then merge",
      matchPackageNames: ["siderolabs/talos"],
      groupName: "talos",
      automerge: false,
      ignoreUnstable: true,
      addLabels: ["renovate/talos", "needs-review"],
      prBodyNotes: [
        "**Upgrade the cluster from this branch BEFORE merging:**",
        "```bash",
        "gh pr checkout {{{branchName}}} && cd talos",
        "topf apply --dry-run   # review the config diff",
        "topf upgrade --dry-run",
        "topf upgrade           # control planes one at a time, drains each node",
        "```",
        "Minor bumps: check the [Talos support matrix](https://docs.siderolabs.com/talos/latest/getting-started/support-matrix) for the running Kubernetes version, and the release notes for config schema changes (1.14 moved `machine.install` to `UnattendedInstallConfig`).",
      ],
    },
    {
      description: "Kubernetes: run upgrade-k8s, then merge (never automerge)",
      matchPackageNames: ["ghcr.io/siderolabs/kubelet"],
      automerge: false,
      ignoreUnstable: true,
      addLabels: ["renovate/kubernetes", "needs-review"],
      prBodyNotes: [
        "**Upgrade the cluster BEFORE merging** — `topf apply` would otherwise roll static pods to this version without skew checks:",
        "```bash",
        "talosctl upgrade-k8s -n 192.168.1.10 --to {{{newVersion}}}",
        "```",
        "Check the [Talos support matrix](https://docs.siderolabs.com/talos/latest/getting-started/support-matrix) first for minor bumps.",
      ],
    },
    {
      description: "topf is pre-1.0: review all non-patch updates",
      matchPackageNames: ["postfinance/topf"],
      matchUpdateTypes: ["minor", "major"],
      automerge: false,
      addLabels: ["needs-review"],
    },
    {
      description: "Group monitoring stack updates",
      matchPackageNames: ["kube-prometheus-stack", "loki", "alloy"],
      groupName: "monitoring stack",
      automerge: false,
      addLabels: ["renovate/monitoring"],
    },
    {
      description: "Group cert-manager updates",
      matchPackageNames: ["/cert-manager/"],
      groupName: "cert-manager",
    },
    {
      description: "Group Flux updates",
      matchPackageNames: ["/fluxcd/", "/^ghcr\\.io\\/fluxcd\\//"],
      groupName: "flux",
    },
    {
      description: "Flag all major version bumps for manual review",
      matchUpdateTypes: ["major"],
      automerge: false,
      addLabels: ["renovate/major", "needs-review"],
    },
  ],
}
